<Window x:Class="CustomStickyNote.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图图便利签"
        Icon="pack://application:,,,/Resources/tray.ico"
        Height="220" Width="220"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{Binding BgBrush}"
        BorderThickness="0"
        MinWidth="120" MinHeight="106"
        PreviewMouseLeftButtonDown="Note_PreviewMouseLeftButtonDown">
    <Grid>
        <!-- NoteBorder 占满整个窗口 (RowSpan=2), 背景 BgBrush.
             AllowsTransparency=False 时窗口背景 Transparent 会渲染为黑色,
             让 NoteBorder 覆盖整个窗口 (包括 HeaderGrid 区域), HeaderGrid 透明时显示 BgBrush 而非黑色. -->
        <Border x:Name="NoteBorder"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{Binding BgBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0">
            <Grid>
                <!-- 内容输入区 (RichTextBox 支持选中文字样式, 顶部留 26px 给 HeaderGrid)
                     窗口 Top = 内容区 Top - 26, 内容区屏幕位置 = _note.Y (不变). -->
               <RichTextBox x:Name="ContentBox"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Hidden"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,26,0,0"
                         Padding="6"
                         CaretBrush="Black"
                         FontFamily="Microsoft YaHei"
                         FontSize="13"
                         LostFocus="Content_LostFocus"
                         TextChanged="Content_TextChanged"
                         SelectionChanged="ContentBox_SelectionChanged"/>

                <!-- 底部工具栏: 浮在内容区底部, 展开时覆盖内容区底部 (不挤压内容).
                     默认 Height=0, 鼠标移入便签时动画展开. -->
                <StackPanel x:Name="ToolbarPanel"
                            VerticalAlignment="Bottom"
                            Background="#60000000"
                            Height="0"
                            ClipToBounds="True">
                    <!-- 第一行: 字体 + 字号 + 加粗 + 行间距 -->
                    <WrapPanel Orientation="Horizontal" Margin="2,1">
                        <!-- 字体下拉 (Focusable=False 防止抢焦点, 保持 RichTextBox 选区) -->
                        <ComboBox x:Name="FontFamilyCombo"
                                  Width="90"
                                  Margin="1,0"
                                  FontSize="11"
                                  Focusable="False"
                                  ToolTip="字体"
                                  SelectionChanged="FontFamily_Changed"/>
                        <!-- 字号下拉 (IsEditable=False + Focusable=False, 从预设选, 不抢焦点) -->
                        <ComboBox x:Name="FontSizeCombo"
                                  Width="38"
                                  Margin="1,0"
                                  FontSize="11"
                                  IsEditable="False"
                                  Focusable="False"
                                  ToolTip="字号"
                                  SelectionChanged="FontSize_Changed"/>
                        <!-- 加粗按钮 (Focusable=False 保持选区) -->
                        <ToggleButton x:Name="BoldToggle"
                                      Content="B"
                                      Width="22"
                                      Margin="1,0"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Focusable="False"
                                      ToolTip="加粗"
                                      Click="BoldToggle_Click"/>
                        <!-- 行间距 -->
                        <TextBlock Text="⇕"
                                   Foreground="#DDD"
                                   VerticalAlignment="Center"
                                   Margin="6,0,2,0"
                                   FontSize="11"
                                   ToolTip="行间距"/>
                        <ComboBox x:Name="LineSpacingCombo"
                                  Width="44"
                                  Margin="1,0"
                                  FontSize="11"
                                  IsEditable="False"
                                  Focusable="False"
                                  ToolTip="行间距倍数"
                                  SelectionChanged="LineSpacing_Changed"/>
                    </WrapPanel>
                    <!-- 第二行: 文字颜色 (颜色配置统一在底部) -->
                    <WrapPanel Orientation="Horizontal" Margin="2,1">
                        <TextBlock Text="A"
                                   Foreground="#DDD"
                                   VerticalAlignment="Center"
                                   Margin="3,0,1,0"
                                   FontSize="11"
                                   ToolTip="文字颜色"/>
                        <StackPanel x:Name="TextColorPanel" Orientation="Horizontal"/>
                    </WrapPanel>
                    <!-- 第三行: 背景颜色 + 透明度滑块 -->
                    <WrapPanel Orientation="Horizontal" Margin="2,1">
                        <TextBlock Text="■"
                                   Foreground="#DDD"
                                   VerticalAlignment="Center"
                                   Margin="3,0,1,0"
                                   FontSize="10"
                                   ToolTip="背景颜色"/>
                        <StackPanel x:Name="ColorPanel" Orientation="Horizontal"/>
                        <TextBlock Text="◐"
                                   Foreground="#DDD"
                                   VerticalAlignment="Center"
                                   Margin="6,0,2,0"
                                   FontSize="11"
                                   ToolTip="背景透明度"/>
                        <Slider x:Name="OpacitySlider"
                                Width="50"
                                Minimum="0.2"
                                Maximum="1.0"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                TickFrequency="0.05"
                                VerticalAlignment="Center"
                                ToolTip="背景透明度"
                                ValueChanged="OpacitySlider_Changed"/>
                    </WrapPanel>
                </StackPanel>

                <!-- 右下角 resize 手柄 (鼠标移入时淡入显示) -->
                <Thumb x:Name="ResizeThumb"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Width="14" Height="14"
                       DragDelta="ResizeThumb_DragDelta"
                       Cursor="SizeNWSE"
                       Background="#66000000"
                       Opacity="0"
                       IsHitTestVisible="False"
                       ToolTip="拖拽调整大小"/>
            </Grid>
        </Border>

        <!-- 标题栏: 浮在 NoteBorder 上方 (后声明 Z order 更高), 顶部 26px.
             Opacity 动画控制可见性: 收起时 Opacity=0 → 透明, 显示下层 NoteBorder 背景色 (BgBrush).
             展开时 Opacity=1 → 显示标题栏 (半透明黑色叠加 BgBrush).
             显式设置 Height=26 VerticalAlignment=Top, 避免依赖 RowDefinitions (SetParent 后可能失效). -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Height="26" VerticalAlignment="Top" Background="#66000000" Opacity="0" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 标题区域: 显示/编辑切换 + 编辑图标 (编辑图标紧贴标题文字右侧, 间距24px) -->
            <StackPanel Grid.Column="0" x:Name="TitleArea" Orientation="Horizontal"
                        MouseEnter="TitleArea_MouseEnter"
                        MouseLeave="TitleArea_MouseLeave">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="{Binding HeaderText}"
                               Foreground="White"
                               Margin="6,2,6,2"
                               FontWeight="Bold"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="140"/>
                    <TextBox x:Name="TitleEditBox"
                             Visibility="Collapsed"
                             Background="White"
                             Foreground="Black"
                             Margin="4,1,4,1"
                             FontSize="12"
                             KeyDown="TitleEditBox_KeyDown"
                             LostFocus="TitleEditBox_LostFocus"/>
                </Grid>
                <Button x:Name="EditTitleButton"
                        Content="✎"
                        Width="20" Height="20"
                        Margin="24,0,0,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        Opacity="0"
                        Click="EditTitle_Click"
                        ToolTip="编辑标题"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- 关闭按钮 -->
                <Button Content="×"
                        Width="20" Height="20"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Click="Close_Click"
                        ToolTip="关闭便签"/>
            </StackPanel>
        </Grid>

        <!-- 右上角眼睛图标 (始终可见, 点击切换标题栏/工具栏显示/隐藏).
             放在根 Grid 中 HeaderGrid 之后, Z order 高于 HeaderGrid, 不被遮挡.
             右边距 26px 避开 HeaderGrid 中的关闭按钮 (20px 宽 + 6px 间隔). -->
        <Button x:Name="ToggleToolbarButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="20" Height="20"
                Margin="0,2,26,0"
                Background="Transparent"
                Foreground="#DD000000"
                BorderThickness="0"
                FontSize="14"
                Content="○"
                Click="ToggleToolbar_Click"
                ToolTip="显示/隐藏工具栏"
                Panel.ZIndex="30"/>
    </Grid>
</Window>
